{
  "name": "replyot",
  "version": "0.5.4",
  "private": true,
  "scripts": {
    "dev": "pnpm run dev:node",
    "build": "pnpm run build:node",
    "build:next": "pnpm run db:bundle && next build",
    "start": "pnpm run start:node",
    "lint": "vp lint .",
    "push:keys": "node scripts/generate-vapid-keys.mjs",
    "db:bundle": "node scripts/generate-migration-bundle.mjs",
    "db:generate": "drizzle-kit generate",
    "db:generate:pg": "MAILFLARE_DB_DIALECT=postgres drizzle-kit generate --config=drizzle.config.pg.ts",
    "db:generate:mysql": "MAILFLARE_DB_DIALECT=mysql drizzle-kit generate --config=drizzle.config.mysql.ts",
    "db:smoke": "node scripts/run-ts.mjs scripts/db-smoke.ts",
    "auth:recovery-link": "node scripts/run-ts.mjs scripts/passkey-recovery-link.ts",
    "db:seed": "curl -X POST http://localhost:3000/api/seed",
    "build:node": "pnpm run db:bundle && next build && node scripts/build-server.mjs",
    "start:node": "node dist/server.mjs",
    "dev:node": "pnpm run db:bundle && node scripts/build-server.mjs && node dist/server.mjs",
    "test:e2e": "playwright test"
  },
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@libsql/client": "^0.18.0",
    "@neondatabase/serverless": "^1.2.0",
    "@planetscale/database": "^2.0.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@tanstack/react-query": "^5.100.11",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "css-tree": "^3.2.1",
    "dayjs": "^1.11.20",
    "dompurify": "^3.4.16",
    "drizzle-orm": "^0.45.2",
    "mailauth": "^4.13.3",
    "mimetext": "^3.0.28",
    "mysql2": "^3.24.6",
    "nanoid": "^5.1.16",
    "next": "16.3.3",
