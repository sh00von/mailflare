    "parse-srcset": "^1.0.2",
    "parse5": "^8.0.1",
    "pg": "^8.23.1",
    "postal-mime": "^2.7.4",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.1",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "^19.2.6",
    "remark-gfm": "^4.0.1",
    "sass": "^1.105.0",
