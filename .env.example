# ==============================================================================
# Replyot Environment Configuration Template (.env.example)
# Copy to `.env` and fill in your secrets: `cp .env.example .env`
# ==============================================================================

# ===== Node & Server Basics =====
NODE_ENV=production
PORT=4008
TRUST_PROXY=1

# ===== Database =====
# PostgreSQL, MySQL, or SQLite:
DATABASE_URL=postgresql://replyot:password@postgres:5432/replyot
POSTGRES_DB=replyot
POSTGRES_USER=replyot
POSTGRES_PASSWORD=password

# ===== URLs & Domain Routing =====
APP_URL=https://mail.example.com
# Optional dedicated subdomains (leave unset to use APP_URL root):
# ADMIN_APP_URL=https://admin.mail.example.com
# MAIL_APP_URL=https://mail.example.com
# COOKIE_DOMAIN=.example.com

# ===== Inbound Mail (SMTP Listener) =====
SMTP_INBOUND_PORT=25
MAIL_HOSTNAME=mail.example.com
# INBOUND_WEBHOOK_SECRET=long-random-hex-string

# ===== Outbound Mail =====
OUTBOUND_PROVIDER=postfix
SMTP_URL=smtp://postfix:587
SMTP_TLS_REJECT_UNAUTHORIZED=false
SYSTEM_FROM_EMAIL=no-reply@example.com

# ===== Redis Queue & Caching =====
REDIS_URL=redis://redis:6379

# ===== Rspamd Anti-Spam Filtering =====
RSPAMD_URL=http://rspamd:11333
RSPAMD_ENABLED=true

# ===== Storage (S3 / Cloudflare R2 / Backblaze B2 / Garage) =====
S3_ENDPOINT=https://s3.example.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=mailflare
S3_REGION=auto
S3_FORCE_PATH_STYLE=true

# ===== Stripe Billing =====
STRIPE_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
STRIPE_WEBHOOK_SECRET=

# ===== Optional Security & Deploy Keys =====
# CAPTCHA_SECRET=
# GITHUB_UPDATE_TOKEN=
# DOKPLOY_DEPLOY_WEBHOOK=
